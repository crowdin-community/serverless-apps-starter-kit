{
  "$schema": "./node_modules/@crowdin/serverless-apps-sdk/manifest.schema.json",
  "name": "Projects dashboard (standalone)",
  "logo": "/logo.svg",
  "scopes": [
    "project.settings:read",
    "project.status.progress:read",
    "group:read"
  ],
  "bundle": {
    "mode": "external",
    "url": "http://localhost:8080/"
  },
  "modules": {
    "organization-menu": [
      {
        "key": "organization-menu",
        "name": "Projects dashboard"
      }
    ],
    "profile-resources-menu": [
      {
        "key": "profile-resources-menu",
        "name": "Projects dashboard"
      }
    ]
  }
}
