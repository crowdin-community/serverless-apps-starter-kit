    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crowdin/serverless-apps-sdk": "0.x",
    "@crowdin/crowdin-api-client": "^1.55.4",
