    "@lingui/react": "^6.2.0",
    "dayjs": "^1.11.21",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@lingui/cli": "^6.2.0",
    "@lingui/format-po": "^6.2.0",
    "@lingui/swc-plugin": "^6.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "fflate": "^0.8.2",
    "sirv": "^3.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-css-injected-by-js": "^5.0.1"
  },
  "engines": {
    "node": "^22.19 || ^24"
